import Image02 from "../assets/processphotos/small-DSCF3233.webp";
import Image03 from "../assets/processphotos/small-DSCF3315.webp";
import Image04 from "../assets/processphotos/small-DSCF3670.webp";
import Image05 from "../assets/processphotos/small-DSCF3741.webp";
import Image06 from "../assets/processphotos/small-DSCF4132.webp";
import Image07 from "../assets/processphotos/small-DSCF4178.webp";
import Image08 from "../assets/processphotos/small-DSCF4308.webp";
import Image09 from "../assets/processphotos/small-DSCF4528.webp";
import Image10 from "../assets/processphotos/small-DSCF4548.webp";
import Image11 from "../assets/processphotos/small-IMG_1404.webp";

import Image12 from "../assets/processphotos/small-DSCF4367.webp";
import Image13 from "../assets/processphotos/small-IMG_0359.webp";
import Image14 from "../assets/processphotos/small-IMG_0361.webp";
import Image15 from "../assets/processphotos/small-IMG_0363.webp";


import Image16 from "../assets/processphotos/small-DSCF4783.webp";
import Image17 from "../assets/processphotos/small-DSCF4807.webp";
import Image18 from "../assets/processphotos/small-DSCF4954.webp";
import Image19 from "../assets/processphotos/small-DSCF4990.webp";
import Image20 from "../assets/processphotos/small-DSCF5005.webp";
import Image21 from "../assets/processphotos/small-DSCF5069.webp";


const projects = [
     {image: Image01, title: ""},
     {image: Image02, title: ""},
     {image: Image03, title: ""},
     {image: Image04, title: ""},
     {image: Image05, title: ""},
     {image: Image06, title: ""},
     {image: Image07, title: ""},
     {image: Image08, title: ""},
     {image: Image09, title: ""},
     {image: Image10, title: ""},
     {image: Image11, title: ""},
     {image: Image12, title: ""},
     {image: Image13, title: ""},
     {image: Image14, title: ""},
     {image: Image15, title: ""},
     {image: Image16, title: ""},
     {image: Image17, title: ""},
     {image: Image18, title: ""},
     {image: Image19, title: ""},
     {image: Image20, title: ""},
     {image: Image21, title: ""},     
     
     ];
---

<InfoLayout>
     <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh">
          <H1> Process </H1>

          <ul class="mt-4 sm:mt-12 grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-16 sm:gap-8">
               {projects.map((project) => (
                    <li>
                         <Image src={project.image} alt={project.title} class="aspect-[1/1.33] object-center object-cover rounded-lg shadow-lg mb-4 sm:mb-0 sm:mr-4" />
                         <div class="p-1 sm:p-2">
                              {/* <h2 class="text-base text-zinc-100">{project.title}</h2> */}
                              {/* <p class="text-sm text-zinc-400 text-balance">{project.description}</p> */}
                         </div>
                    </li>
               ))}
          </ul>
     </div>
</InfoLayout>