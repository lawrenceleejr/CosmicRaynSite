---
import H1 from "../components/h1.astro";
import Link from "../components/link.astro";
import Navigation from "../components/navigation";
import RootLayout from "../layouts/RootLayout.astro";
---

<RootLayout>
	<main>

		<video   id="bg-video" autoplay muted loop playsinline>
		<!-- <source src="/earth.mp4" type="video/mp4" /> -->
		<source src="./Travel_Wide.mp4" type="video/mp4" />
		</video>

		<script>
		document.addEventListener('astro:page-load', () => {
			// Find all videos and reload them
			const videos = document.querySelectorAll('video');
			videos.forEach(video => {
			// Only reload if it's not already playing
			if (video.paused && video.autoplay) {
				video.load();
				video.play().catch(() => {
				// Autoplay might be blocked, that's okay
				});
			}
			});
		});
		</script>

		
		<div id="overlay"></div>

		<div class="group relative w-full min-h-dvh flex items-center justify-center">
			<div class="absolute w-full h-dvh -z-10"> -->
			</div>

			<div class="p-4 sm:p-8 absolute w-full h-dvh flex flex-col justify-between z-10">
				<div>


					<script>
					document.addEventListener('astro:page-load', () => {
						// Find all videos and reload them
						const videos = document.querySelectorAll('video');
						videos.forEach(video => {
						// Only reload if it's not already playing
						if (video.paused && video.autoplay) {
							video.load();
							video.play().catch(() => {
							// Autoplay might be blocked, that's okay
							});
						}
						});

						// Reveal logo with a subtle blur -> clear animation for a luxe feel
						const logo = document.querySelector('img.logo-reveal');
						if (logo) {
							// Small delay so the page paints first, gives a nicer entrance
							setTimeout(() => logo.classList.add('loaded'), 120);
						}
					});
					</script>

					<style>
					:root { --logo-blur: 18px; }

					/* Luxurious blur-to-sharp reveal for the logo */
					.logo-reveal {
						filter: blur(var(--logo-blur)) saturate(.95);
						opacity: 0;
						transform: translateY(8px) scale(.995);
						transition: filter 900ms cubic-bezier(.2,.9,.3,1), opacity 900ms ease, transform 900ms cubic-bezier(.2,.9,.3,1);
						will-change: filter, opacity, transform;
						pointer-events: none;
					}
					.logo-reveal.loaded {
						filter: blur(0) saturate(1);
						opacity: 1;
						transform: translateY(0) scale(1);
					}

					/* Respect reduced motion preference */
					@media (prefers-reduced-motion: reduce) {
						.logo-reveal,
						.logo-reveal.loaded {
							transition: none;
							filter: none;
							transform: none;
							opacity: 1;
						}
					}
					</style>

					<!-- <H1 size="large"> Cosmic <br /> Rayn </H1> -->
					 <img 
					src="./logo_white.png" 
					alt="Logo" 
					class="logo-reveal fixed max-sm:top-[100px] max-sm:left-1/2 max-sm:-translate-x-1/2 max-sm:max-w-[80%] sm:top-0 sm:left-[50px] sm:max-w-[45%] sm:max-w-[500px] z-20 pointer-events-none"
					/>
				</div>

				<div>
					<div class="mb-2 sm:mb-4 flex items-center justify-between">
						<div class="flex items-center gap-4">
							<Link href="./about">About the project</Link>
							<Link href="./gallery" variant="secondary">Gallery</Link>
						</div>

						<Navigation client:load>
							<!-- <Link href="/blog" variant="secondary">Blog</Link> -->
							<!-- <Link href="/contributors" variant="secondary">Contributors</Link> -->
							<!-- <Link href="/contact" variant="secondary">Contact</Link> -->

							<!-- <Link href="/about" openNewTab={false} variant="secondary">About</Link> -->
							<!-- <Link href="/gallery" openNewTab={false} variant="secondary">Gallery</Link> -->
							<Link href="./build" openNewTab={false} variant="secondary">Process</Link>
							<Link href="./contributors" openNewTab={false} variant="secondary">Contributors</Link>
							<Link href="./acknowledgements" openNewTab={false} variant="secondary">Acknowledgements</Link>
						</Navigation>
						
					</div>
				</div>
			</div>
		</div>
		<!-- Lower-right vector logo -->
		<!-- <img 
			src="/Asset 13.png" 
			alt="Logo" 
			class="fixed bottom-30 right-4 w-80 h-60 z-20 pointer-events-none"
		/> -->

		<img 
			src="./utklogo.png" 
			alt="Logo" 
			class="fixed top-0 right-0 max-sm:max-w-[50%] max-w-[25%] z-20 pointer-events-none"
		/>
	</main>
</RootLayout>
